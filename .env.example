# Firebase Web App Configuration
# Obtain these values from:
# Firebase Console -> Project Settings -> General -> Your apps -> Web App -> Firebase SDK setup / Config

VITE_FIREBASE_API_KEY=your_actual_firebase_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=kevorch-website.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=kevorch-website
VITE_FIREBASE_STORAGE_BUCKET=kevorch-website.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your_actual_messaging_sender_id
VITE_FIREBASE_APP_ID=your_actual_app_id
